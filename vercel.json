{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "github": {
    "silent": true
  },
  "rewrites": [
    { "source": "/((?!assets|dashboard|sw|manifest|favicon).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-snapshot",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/risk-monitor",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/ai-research",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/opportunity-scanner",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/dividend-tracker",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/monthly-report",
      "schedule": "0 7 1 * *"
    }
  ]
}
